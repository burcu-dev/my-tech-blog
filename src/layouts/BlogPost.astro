---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 800px;
				margin: 0 auto;
				padding: 0 1em;
			}
			.hero-image {
				width: 100%;
				max-width: 720px;
				margin: 0 auto 1.5rem auto;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 380px;
				object-fit: cover;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}

			/* BAŞLIK BLOĞU (.prose DIŞINDA - HİÇBİR CSS KARIŞAMAZ) */
			.article-header {
				width: 100%;
				max-width: 720px;
				margin: 0 auto 1.5rem auto;
				text-align: center;
			}
			.article-title {
				font-size: clamp(1.8rem, 4vw, 2.4rem);
				font-weight: 800;
				line-height: 1.2;
				color: #111827;
				margin: 0 0 0.6rem 0;
			}
			.article-date {
				font-size: 0.95rem;
				color: #6b7280;
				margin-bottom: 0.8rem;
			}
			.article-description {
				font-size: 1.1rem;
				font-style: italic;
				color: #4b5563;
				line-height: 1.5;
				margin: 0.8rem 0 1.2rem 0;
			}
			.article-header hr {
				border: 0;
				border-top: 1px solid #e5e7eb;
				margin-top: 1.2rem;
			}

			/* İÇERİK METİN ALANI */
			.prose {
				width: 100%;
				max-width: 720px;
				margin: 0 auto;
				color: #374151;
				line-height: 1.8;
				font-size: 1.05rem;
			}
			.prose :global(h1) {
				font-size: 1.5rem;
				margin-top: 1.6em;
				margin-bottom: 0.5em;
				font-weight: 700;
			}
			.prose :global(h2) {
				font-size: 1.35rem;
				margin-top: 1.5em;
				margin-bottom: 0.5em;
				font-weight: 700;
			}
			.prose :global(h3) {
				font-size: 1.15rem;
				margin-top: 1.3em;
				margin-bottom: 0.4em;
				font-weight: 600;
			}
			.prose :global(p) {
				margin-bottom: 1.3em;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{/* Kapak Resmi */}
				<div class="hero-image">
					{heroImage && <img width="1020" height="510" src={heroImage} alt="" />}
				</div>

				{/* Makale Başlık Bloğu */}
				<div class="article-header">
					<h1 class="article-title">{title}</h1>
					<div class="article-date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="last-updated-on">
									(Updated: <FormattedDate date={updatedDate} />)
								</span>
							)
						}
					</div>
					{description && <p class="article-description">{description}</p>}
					<hr />
				</div>

				{/* Makale İçeriği */}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
