---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
			}
			.header-banner {
				width: 100%;
				height: 280px;
				object-fit: cover;
				object-position: center;
				border-radius: 12px;
				margin-bottom: 2rem;
			}
			h1 {
				font-size: clamp(1.5rem, 3.5vw, 2rem) !important;
				line-height: 1.3 !important;
				margin-top: 1rem !important;
				margin-bottom: 1rem !important;
				color: #111827 !important;
			}
			p {
				line-height: 1.7;
				margin-bottom: 1.25rem;
				font-size: 1.05rem;
				color: #374151;
			}
			@media (max-width: 720px) {
				.header-banner {
					height: 180px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<img 
				src="/data-center-header.png" 
				alt="NewsAiTech Header" 
				class="header-banner" 
			/>

			<h1>👋 Hi there, non-tech tech lovers!</h1>
			
			<p>
				Welcome to <strong>NewsAiTech</strong>—your go-to space for global tech news, decoded for real human beings.
			</p>
			
			<p>
				Love keeping up with the future, but hate getting lost in specs, silicon jargon, and endless engineering terms? You’re in the exact right place!
			</p>
			
			<p>
				We don't stop at hardware. We explore the <em>human side</em> of technology—how new innovations actually shape our daily lives, our wallets, society, and consumer psychology.
			</p>
			
			<p>
				Grab a coffee, sit back, and let’s make sense of the future together!
			</p>

			<br />
			<p>
				👉 <a href="/blog"><strong>Check out our latest stories & blog posts →</strong></a>
			</p>
		</main>
		<Footer />
	</body>
</html>
